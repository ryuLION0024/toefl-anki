[
 {
  "group": "方向・位置",
  "desc": "「どこへ・どこから・どこを通って」を表す接頭辞。学術語に最も多く、AWL 単語の分解でも頻出。",
  "items": [
   {
    "p": "ab-",
    "forms": "ab-, abs-, a-",
    "m": "離れて",
    "note": "「元の場所から離れる」イメージ。abs- は c・t の前で使われる形。",
    "ex": [
     {
      "w": "abstract"
     },
     {
      "w": "absorb",
      "ja": "吸収する"
     },
     {
      "w": "abnormal",
      "ja": "異常な"
     }
    ]
   },
   {
    "p": "ad-",
    "forms": "ad-, ac-, af-, al-, ap-, as-, at-",
    "m": "〜へ・〜に向かって",
    "note": "後ろの子音に合わせて形が変わる（同化）。acc-・aff-・all-・app-・ass-・att- のように子音が重なっていたら ad- を疑う。",
    "ex": [
     {
      "w": "adapt"
     },
     {
      "w": "adjacent"
     },
     {
      "w": "accumulate"
     },
     {
      "w": "affect"
     },
     {
      "w": "allocate"
     },
     {
      "w": "approximate"
     },
     {
      "w": "assess"
     },
     {
      "w": "attain"
     }
    ]
   },
   {
    "p": "circum-",
    "forms": "circum-",
    "m": "周りに・ぐるりと",
    "note": "circle（円）と同じ語源。",
    "ex": [
     {
      "w": "circumstance"
     },
     {
      "w": "circumference",
      "ja": "円周"
     },
     {
      "w": "circumvent",
      "ja": "回避する"
     }
    ]
   },
   {
    "p": "con-",
    "forms": "con-, com-, col-, cor-, co-",
    "m": "共に・完全に",
    "note": "「一緒に」と「すっかり（強調）」の2つの意味がある。b・m・p の前で com-、l の前で col-、r の前で cor- になる。",
    "ex": [
     {
      "w": "concept"
     },
     {
      "w": "conclude"
     },
     {
      "w": "consist"
     },
     {
      "w": "comprise"
     },
     {
      "w": "collapse"
     },
     {
      "w": "correspond"
     },
     {
      "w": "cooperate"
